# /usr/local/etc/insider840-morning/env — режим root:dash 0640, формат KEY=value без кавычек и export.

# Воркер radar840-quotes (Cloudflare): сюда уходит готовый morning.json, оттуда берутся бары.
PAPER_URL=https://radar840-quotes.financehub.workers.dev
# Токен записи в воркер — секрет воркера PAPER_TOKEN (wrangler secret put PAPER_TOKEN). Новых секретов не заводим.
# Пока пусто — скрипт собирает список, но отправить его некуда, юнит завершается с ошибкой.
PAPER_TOKEN=

# Письмо с VPS сразу после сборки. Оба поля заданы — письмо уходит отсюда (дубль с GitHub исключает отметка в воркере);
# пусты — VPS только собирает и публикует список, письмо отправляет ежедневная сборка на GitHub, как раньше.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Зеркало письма в ленту NEXUS (необязательно; хаб сам отбрасывает повтор по eventId)
NEXUS_EVENTS_URL=
NEXUS_INGEST_TOKEN=
