[Unit]
Description=Инсайдерский радар 840 · лента формы 4 на весь день: getcurrent EDGAR каждые 45 с, 06:00–22:00 ET, журнал в /var/lib/insider840-feed (сверка с индексом в 22:03)
Wants=network-online.target
After=network-online.target
# Сбой посреди дня перезапускается (состояние читается из журнала); шесть стартов в час гасят только петлю.
StartLimitIntervalSec=3600
StartLimitBurst=6

[Service]
Type=simple
User=dash
Group=dash
WorkingDirectory=/srv/dash/repo-840
Environment=NODE_ENV=production
# Секретов нет: SEC читается с User-Agent проекта, журнал остаётся на диске VPS (его читает сборка утреннего списка, insider840-morning).
ExecStart=/usr/bin/node scripts/vps/feed-collector.mjs --dir /var/lib/insider840-feed --from 06:00 --until 22:00 --interval 45
Restart=on-failure
RestartSec=30
# 06:00 → 22:00 ET = 16 ч; предел 17 ч страхует только от зависшего процесса
RuntimeMaxSec=61200
SyslogIdentifier=insider840-feed

StateDirectory=insider840-feed
StateDirectoryMode=0750
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
MemoryHigh=256M
MemoryMax=512M
Nice=5

# Тревога из systemd: ИМЕННО ExecStopPost, а не OnFailure (приходит и «упало», и «снова проходит»)
ExecStopPost=-+/usr/local/sbin/dash-alert %n
