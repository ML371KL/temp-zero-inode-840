[Unit]
Description=Инсайдерский радар 840 · справочник D−1 для сигнала в торговые часы: 23:52 и 07:00 по Нью-Йорку, будни

[Timer]
Unit=insider840-signals-ref.service
# 23:52 — после предела сборки утреннего списка (23:48) и ночного прогона GitHub: бары дня закрыты, процессор свободен.
# 07:00 — повтор, если ночью справочник не собрался (иначе выход без работы). Биржевые праздники и выходные скрипт знает сам:
# справочник строится на следующий торговый день по последнему закрытому бару.
OnCalendar=Mon..Fri *-*-* 23:52:00 America/New_York
OnCalendar=Mon..Fri *-*-* 07:00:00 America/New_York
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
