[Unit]
Description=Инсайдерский радар 840 · сигнал в торговые часы: хвост журнала ленты формы 4 → событие эмитента по справочнику D−1 → /var/lib/insider840-signals/ГГГГ-ММ-ДД.jsonl (читает бот ib840)
# Сети не нужно: журнал ленты и справочник лежат на диске
StartLimitIntervalSec=3600
StartLimitBurst=6

[Service]
Type=simple
User=dash
Group=dash
WorkingDirectory=/srv/dash/repo-840
Environment=NODE_ENV=production
ExecStart=/usr/bin/node scripts/vps/signal-watch.mjs --dir /var/lib/insider840-signals --feed-dir /var/lib/insider840-feed --from 09:25 --until 16:05
# Сбой посреди дня перезапускается: записанные сигналы читаются из файла дня, формы — из журнала ленты, повторов нет.
# Код 3 — «сигналов сегодня нет» (справочника D−1 нет или справочники иностранных эмитентов не готовы): тревога уходит один раз,
# перезапуска нет. Код 1 — тревога контура (медиана задержки ленты за час выше двух минут) или сбой: перезапуск через 15 секунд.
Restart=on-failure
RestartSec=15
RestartPreventExitStatus=3
# 09:25 → 16:05 ET = 6 ч 40 мин; предел 8 ч страхует только от зависшего процесса
RuntimeMaxSec=28800
SyslogIdentifier=insider840-signals

StateDirectory=insider840-signals
StateDirectoryMode=0755
UMask=0022
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
MemoryHigh=384M
MemoryMax=768M
# В окне контура процессор сервера занят фоновыми задачами на 75–80% (замер 17.11.2026); Nice между службами разных групп не
# работает — доля процессора задаётся весом группы (по умолчанию 100)
CPUWeight=400

# Тревога из systemd: ИМЕННО ExecStopPost, а не OnFailure (приходит и «упало», и «снова проходит»)
ExecStopPost=-+/usr/local/sbin/dash-alert %n
