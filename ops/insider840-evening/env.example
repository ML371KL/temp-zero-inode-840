# /usr/local/etc/insider840-evening/env — режим root:dash 0640, формат KEY=value без кавычек и export.

# Воркер котировок (край Cloudflare, свой пул адресов — НЕ Yahoo напрямую: адрес VPS уже почти выбрал часовой лимит из-за 839)
QUOTES_URL=https://radar840-quotes.financehub.workers.dev/quotes

# Куда присылать журнал: тот же воркер, привязка R2 PAPER. Токен — СЕКРЕТ приёма (только запись; читать журнал токен не нужен):
# тот же, что выдан воркеру командой «wrangler secret put PAPER_TOKEN». Пока пусто — журнал остаётся на диске, юнит завершается с ошибкой.
PAPER_URL=https://radar840-quotes.financehub.workers.dev
PAPER_TOKEN=
PAPER_DIR=/var/lib/insider840-evening/paper

# api.nasdaq.com как второй источник bid/ask (обычный запрос с честным User-Agent проекта). 0 — выключен.
# Включать только после пробы: node scripts/evening/probe-quotes.mjs --nasdaq вечером по Нью-Йорку
EVENING_NASDAQ=0
