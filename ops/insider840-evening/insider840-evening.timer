[Unit]
Description=Инсайдерский радар 840 · вечерний сборщик: старт в 15:55 по Нью-Йорку, будни

[Timer]
Unit=insider840-evening.service
# Время — нью-йоркское (с переходом на зимнее и летнее время): окно приёма форм 16:00–20:00 ET привязано к нему, а не к UTC.
# Праздники биржи сборщик не знает: SEC в эти дни форм не принимает, и вечер проходит с нулём событий — это не ошибка.
OnCalendar=Mon..Fri *-*-* 15:55:00 America/New_York
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
